# === Gateway-Auth (deine eigene API) ===
# Starker, zufaelliger Bearer-Token, den externe Clients senden muessen.
# Erzeugen z.B. mit:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# === Claude-Code-Abo-Auth ===
# Langlebiger OAuth-Token aus `claude setup-token` (lokal, einmalig mit Browser).
# Nutzt DEIN Abo. NICHT ins Image bauen -> nur zur Laufzeit setzen.
CLAUDE_CODE_OAUTH_TOKEN=

# WICHTIG: ANTHROPIC_API_KEY bewusst NICHT setzen.
# Waere er gesetzt, haette er Vorrang -> Abrechnung per Token statt ueber das Abo.
# ANTHROPIC_API_KEY=

# Optional: Pfad zu einer bestimmten `claude`-Binary (leer = gebuendelte SDK-Binary).
# Nuetzlich, falls eine org-verwaltete CLI genutzt werden muss (managed settings).
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# === Server ===
HOST=0.0.0.0
PORT=8000

# === Workspaces ===
# Basisverzeichnis fuer Session-Workspaces. Im Container: /workspaces
WORKSPACES_DIR=./workspaces

# === Verhalten / Defaults ===
# permission_mode: default | acceptEdits | plan | bypassPermissions
DEFAULT_PERMISSION_MODE=acceptEdits
# Optionales Standard-Modell (leer = Claude-Code-Default)
DEFAULT_MODEL=
# Session-Lebensdauer bei Inaktivitaet (Sekunden)
SESSION_TTL_SECONDS=3600
# Max. gleichzeitige Sessions
MAX_SESSIONS=20
# Einfaches Rate-Limit: max. Requests pro Minute je Client-IP
RATE_LIMIT_PER_MINUTE=60
